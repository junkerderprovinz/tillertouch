{
  "description": "TillerTouch: a nudge toward a better route on each prompt, a second look at each tool call, and a second look at each reply before the turn ends.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/tillertouch.mjs\" nudge",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/tillertouch.mjs\" judge claude",
            "timeout": 120,
            "statusMessage": "TillerTouch is checking the call"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/tillertouch.mjs\" judge claude",
            "timeout": 120,
            "statusMessage": "TillerTouch is reading the reply"
          }
        ]
      }
    ]
  }
}
